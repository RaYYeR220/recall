{
  "name": "studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "compass:deploy": "bun run ./scripts/compass-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "lint": "oxlint --type-aware src scripts packages api --fix; s=$?; oxlint --fix .; exit $((s>0?s:$?))",
    "typecheck": "tsc --noEmit; a=$?; tsc --noEmit -p packages/sdk/tsconfig.json; b=$?; tsc --noEmit -p api/tsconfig.json; c=$?; tsc --noEmit -p api/_test/tsconfig.json; d=$?; tsc --noEmit -p packages/mcp/tsconfig.json; e=$?; m=0; for x in $a $b $c $d $e; do [ $x -gt $m ] && m=$x; done; exit $m",
    "check": "bash scripts/check.sh",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "sdk:test": "cd packages/sdk && bun test",
    "sdk:abi": "bun run ./scripts/gen-abi.ts",
    "verify:onchain": "bun run ./scripts/verify-onchain.ts",
    "build": "vite build",
    "preview": "vite preview",
    "api:test": "cd api && bun test",
    "mcp:test": "cd packages/mcp && bun test"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.19.2",
    "@circle-fin/app-kit": "^1.18.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.1",
    "@circle-fin/user-controlled-wallets": "^10.8.1",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@openzeppelin/contracts": "5.6.1",
    "@tanstack/react-query": "^5.62.7",
    "@web3icons/react": "^4.0.0",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "2.57.5",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
